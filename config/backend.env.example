# Copy values into your secret manager or an ignored local environment file.
# Never commit real credentials.
NODE_ENV=development
# Use DEPLOYMENT_ENV=staging or production only with explicit real providers,
# HTTPS origins, non-loopback services and secrets supplied by a secret manager.
DEPLOYMENT_ENV=development
DATABASE_URL=postgresql://xiongzai:change-me@127.0.0.1:5432/xiongzai
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

API_HOST=127.0.0.1
# 仅在可信局域网真机测试时临时设置为开发电脑私有IPv4；不得提交固定值
LOCAL_LAN_HOST=
API_PORT=3002
API_BODY_LIMIT_BYTES=1048576
# Comma-separated proxy CIDRs. Keep empty locally; never use 0.0.0.0/0 in protected environments.
API_TRUSTED_PROXY_CIDRS=
TOKEN_ISSUER=xiongzai-api
USER_TOKEN_AUDIENCE=xiongzai-user
ADMIN_TOKEN_AUDIENCE=xiongzai-admin
INTERNAL_TOKEN_AUDIENCE=xiongzai-internal
USER_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PII_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
PII_HMAC_KEY=replace-with-at-least-32-random-bytes
AUTH_HMAC_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SMS_PROVIDER_MODE=development
# Local development only. Never log or return this value from an API.
SMS_DEVELOPMENT_CODE=246810
SMS_CODE_TTL_SECONDS=300
SMS_MAX_ATTEMPTS=5
SMS_MINIMUM_INTERVAL_SECONDS=60
PAYMENT_PROVIDER_MODE=mock
# Local mock callback signing only. Production must use a secret manager and injected provider.
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
PAYOUT_PROVIDER_MODE=mock
# Local mock payout callback signing only. Production must inject a real provider.
PAYOUT_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
API_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Object storage provider: disabled, minio, aliyun-oss, or injected.
# Local development uses MinIO. The aliyun-oss provider delegates to a future injected official Aliyun OSS SDK adapter.
FILE_STORAGE_PROVIDER=disabled
FILE_STORAGE_ENDPOINT=http://127.0.0.1:9000
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key-id
FILE_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-access-key
FILE_PUBLIC_BUCKET=xiongzai-public-media
FILE_PRIVATE_BUCKET=xiongzai-private-media
FILE_QUARANTINE_BUCKET=xiongzai-quarantine-media
FILE_UPLOAD_URL_TTL_SECONDS=600
FILE_UPLOAD_SESSION_TTL_SECONDS=3600
FILE_DOWNLOAD_URL_TTL_SECONDS=300
FILE_UPLOAD_HOURLY_LIMIT=20
FILE_LIFECYCLE_MAX_ATTEMPTS=8
FILE_LIFECYCLE_SWEEP_BATCH_SIZE=100
FILE_LIFECYCLE_SWEEP_INTERVAL_SECONDS=60
FILE_ORPHAN_AUDIT_PAGE_SIZE=100
FILE_ORPHAN_AUDIT_MAX_OBJECTS=1000
# 0 表示默认不自动清理审核拒绝文件；启用前必须确定业务保留期。
FILE_REJECTED_RETENTION_SECONDS=0
# Optional CDN origin for approved public files. Leave empty for local MinIO signed GET URLs.
PUBLIC_ASSET_BASE_URL=
FILE_PUBLIC_ASSET_PATH_MODE=bucket-and-key

WORKER_ID=worker-local-1
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=8
# Development only. Production must inject a real EventPublisher adapter.
EVENT_PUBLISHER_MODE=log

SCHEDULER_ID=scheduler-local-1
SCHEDULER_BATCH_SIZE=20
SCHEDULER_POLL_INTERVAL_MS=1000
