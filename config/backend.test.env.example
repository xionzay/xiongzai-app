NODE_ENV=test
DEPLOYMENT_ENV=test
# Must be a disposable PostgreSQL 16 database, never production.
DATABASE_URL=postgresql://xiongzai_test:change-me@127.0.0.1:5432/xiongzai_api_test
TEST_DATABASE_URL=postgresql://xiongzai_test:change-me@127.0.0.1:5432/xiongzai_database_test
API_HOST=127.0.0.1
API_PORT=33002
API_BODY_LIMIT_BYTES=1048576
API_TRUSTED_PROXY_CIDRS=
USER_TOKEN_SECRET=test-user-secret-at-least-32-bytes-long
ADMIN_TOKEN_SECRET=test-admin-secret-at-least-32-bytes-long
INTERNAL_TOKEN_SECRET=test-internal-secret-at-least-32-bytes-long
CURSOR_SIGNING_SECRET=test-cursor-secret-at-least-32-bytes-long
PII_ENCRYPTION_KEY=test-pii-encryption-key-at-least-32-bytes
PII_HMAC_KEY=test-pii-hmac-key-at-least-32-bytes-long
AUTH_HMAC_KEY=test-auth-hmac-key-at-least-32-bytes
SMS_PROVIDER_MODE=injected
SMS_DEVELOPMENT_CODE=246810
SMS_CODE_TTL_SECONDS=300
SMS_MAX_ATTEMPTS=3
SMS_MINIMUM_INTERVAL_SECONDS=1
PAYMENT_PROVIDER_MODE=mock
PAYMENT_WEBHOOK_SECRET=test-payment-webhook-secret-at-least-32-bytes
PAYOUT_PROVIDER_MODE=mock
PAYOUT_WEBHOOK_SECRET=test-payout-webhook-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=3600
API_CORS_ORIGINS=http://localhost:3001
FILE_STORAGE_PROVIDER=disabled
FILE_PUBLIC_BUCKET=xiongzai-test-public-media
FILE_PRIVATE_BUCKET=xiongzai-test-private-media
FILE_QUARANTINE_BUCKET=xiongzai-test-quarantine-media
FILE_PUBLIC_ASSET_PATH_MODE=bucket-and-key
FILE_UPLOAD_URL_TTL_SECONDS=600
FILE_UPLOAD_SESSION_TTL_SECONDS=3600
FILE_DOWNLOAD_URL_TTL_SECONDS=300
FILE_UPLOAD_HOURLY_LIMIT=20
FILE_LIFECYCLE_MAX_ATTEMPTS=4
FILE_LIFECYCLE_SWEEP_BATCH_SIZE=50
FILE_LIFECYCLE_SWEEP_INTERVAL_SECONDS=60
FILE_ORPHAN_AUDIT_PAGE_SIZE=50
FILE_ORPHAN_AUDIT_MAX_OBJECTS=200
FILE_REJECTED_RETENTION_SECONDS=0
EVENT_PUBLISHER_MODE=log
OUTBOX_MAX_ATTEMPTS=4
