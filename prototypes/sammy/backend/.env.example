# Use a dedicated Neon database, not the company app database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/sammy?sslmode=verify-full
PORT=3100
# Cloudinary Free account. Server only: never use EXPO_PUBLIC_ for these values.
# When all three are set, Cloudinary handles new media instead of S3.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Private Cloudflare R2 bucket. Never put these in EXPO_PUBLIC variables.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=sammy-prototype
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Synthetic money only. Local opt-in, or explicitly enabled Vercel Preview.
SAMMY_SIMULATED_PAYMENTS=false

# Set true ONLY in Vercel Preview, alongside SAMMY_SIMULATED_PAYMENTS=true.
# Leave unset locally. Production and unknown Vercel targets always block simulation.
# Preview must use a dedicated test Neon branch and private test bucket.
# SAMMY_HOSTED_DEMO=true
