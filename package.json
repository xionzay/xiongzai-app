{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern '**/dist/**' --ignore-pattern '.next/**' --ignore-pattern '.vinext/**'",
    "db:generate": "pnpm --filter @xiongzai/database db:generate",
    "db:migrate": "pnpm --filter @xiongzai/database db:migrate",
    "db:check": "pnpm --filter @xiongzai/database db:check",
    "db:studio": "pnpm --filter @xiongzai/database db:studio",
    "db:test": "pnpm --filter @xiongzai/database test",
    "db:local:setup": "node packages/database/scripts/setup-local-postgres.mjs",
    "db:local:verify": "node --env-file=.env.backend.local packages/database/scripts/verify-local-postgres.mjs",
    "backend:build": "pnpm --filter './packages/**' --filter './apps/**' build",
    "backend:typecheck": "pnpm run backend:build && pnpm --filter './packages/**' --filter './apps/**' typecheck",
    "backend:test": "pnpm --filter './packages/**' --filter './apps/**' test",
    "e2e:test": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local --test apps/api/tests/user-journey.e2e.test.mjs",
    "api:dev": "pnpm --filter @xiongzai/api dev",
    "admin:bootstrap": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local apps/api/scripts/bootstrap-admin.mjs",
    "worker:dev": "pnpm --filter @xiongzai/worker dev",
    "scheduler:dev": "pnpm --filter @xiongzai/scheduler dev"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
