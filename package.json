{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "heroku-postbuild": "npm --prefix prototypes/sammy/backend ci --include=dev --workspaces=false && npm --prefix prototypes/sammy/backend run build && npm --prefix prototypes/sammy/backend prune --omit=dev --workspaces=false",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3001",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --env-file-if-exists=.env.backend.local --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern '**/dist/**' --ignore-pattern '.next/**' --ignore-pattern '.vinext/**'",
    "db:generate": "pnpm --filter @xiongzai/database db:generate",
    "db:migrate": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/database db:migrate",
    "db:check": "pnpm --filter @xiongzai/database db:check",
    "db:migration:status": "node --env-file-if-exists=.env.backend.local scripts/migration-status.mjs",
    "db:studio": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/database db:studio",
    "db:test": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/database test",
    "db:local:start": "node packages/database/scripts/start-local-postgres.mjs",
    "db:local:stop": "node packages/database/scripts/stop-local-postgres.mjs",
    "db:local:reset": "node packages/database/scripts/reset-local-development-database.mjs",
    "db:local:setup": "node packages/database/scripts/setup-local-postgres.mjs",
    "db:local:verify": "node --env-file=.env.backend.local packages/database/scripts/verify-local-postgres.mjs",
    "backend:build": "pnpm --filter './packages/**' --filter './apps/**' build",
    "backend:typecheck": "pnpm run backend:build && pnpm --filter './packages/**' --filter './apps/**' typecheck",
    "backend:test": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter './packages/**' --filter './apps/**' test",
    "e2e:test": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local --test apps/api/tests/user-journey.e2e.test.mjs",
    "admin:e2e": "pnpm run build && pnpm --filter './packages/**' --filter @xiongzai/api build && node --env-file=.env.backend.local --env-file=.env.minio.local node_modules/@playwright/test/cli.js test --config=playwright.config.mjs",
    "admin:quality": "node --env-file-if-exists=.env.backend.local --env-file-if-exists=.env.minio.local scripts/admin-quality.mjs",
    "admin:preprod": "node --env-file-if-exists=.env.backend.local --env-file-if-exists=.env.minio.local scripts/admin-preprod.mjs",
    "api:dev": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/api dev",
    "admin:bootstrap": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local apps/api/scripts/bootstrap-admin.mjs",
    "manual-test:seed": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local --env-file=.env.manual-test.local apps/api/scripts/seed-local-manual-test.mjs",
    "policy:local:seed": "pnpm --filter @xiongzai/database build && node --env-file=.env.backend.local apps/api/scripts/seed-local-policy-drafts.mjs",
    "manual-test:totp": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local --env-file=.env.manual-test.local apps/api/scripts/print-local-manual-totp.mjs",
    "storage:local:prepare": "node apps/api/scripts/prepare-local-minio-env.mjs",
    "storage:local:start": "node apps/api/scripts/start-local-minio.mjs",
    "storage:local:configure": "node apps/api/scripts/configure-local-minio.mjs",
    "storage:local:verify": "pnpm --filter @xiongzai/api build && node --env-file=.env.backend.local apps/api/scripts/verify-local-minio.mjs",
    "worker:dev": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/worker dev",
    "scheduler:dev": "node --env-file=.env.backend.local scripts/run-pnpm-with-backend-env.mjs --filter @xiongzai/scheduler dev",
    "local:prepare": "pnpm db:local:start && pnpm db:local:setup && pnpm storage:local:prepare && pnpm backend:build && pnpm db:migrate && pnpm policy:local:seed && pnpm local:doctor:config",
    "local:seed": "pnpm storage:local:configure && pnpm storage:local:verify && pnpm policy:local:seed && pnpm manual-test:seed",
    "local:run": "pnpm backend:build && node scripts/run-local-stack.mjs",
    "local:doctor": "node --env-file=.env.backend.local scripts/local-test-doctor.mjs",
    "local:doctor:config": "node --env-file=.env.backend.local scripts/local-test-doctor.mjs --config-only",
    "mobile:start": "pnpm --filter @xiongzai/mobile start",
    "mobile:start:simulator": "NODE_OPTIONS=--dns-result-order=ipv4first REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 pnpm --filter @xiongzai/mobile exec expo start --dev-client --localhost --clear",
    "mobile:open:simulator": "node scripts/open-mobile-simulator.mjs",
    "mobile:ios": "pnpm --filter @xiongzai/mobile ios",
    "mobile:ios:simulator": "NODE_OPTIONS=--dns-result-order=ipv4first REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 pnpm --filter @xiongzai/mobile exec expo run:ios",
    "mobile:android": "pnpm --filter @xiongzai/mobile android",
    "mobile:prebuild": "pnpm --filter @xiongzai/mobile prebuild",
    "mobile:typecheck": "pnpm --filter @xiongzai/mobile typecheck",
    "mobile:test": "pnpm --filter @xiongzai/mobile test",
    "mobile:lint": "pnpm --filter @xiongzai/mobile lint",
    "mobile:doctor": "pnpm --filter @xiongzai/mobile run expo:doctor"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
